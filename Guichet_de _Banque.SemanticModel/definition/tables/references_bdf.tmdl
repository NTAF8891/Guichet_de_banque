	partition references_bdf = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "references_banque_de_france.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
