	partition dab_osm = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "dab_osm.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"id_osm", Int64.Type}, {"lat", type number}, {"lon", type number}, {"type_osm", type text}, {"enseigne", type text}, {"code_commune", type text}}, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table
