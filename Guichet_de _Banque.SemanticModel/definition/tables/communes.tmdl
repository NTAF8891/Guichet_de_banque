table communes
	lineageTag: 4c6786cc-c65f-4fc1-968d-c39288dd41f0

	measure Population = SUM ( communes[population_2023] )
		formatString: #,0
		lineageTag: fb116c2e-a783-43c5-b079-6ab1f1644c3f

	measure Communes = COUNTROWS ( communes )
		formatString: #,0
		lineageTag: c29c064f-1e51-4513-aa01-eba0f5ab9552

	measure Agences = SUM ( communes[agences_bancaires_2025] )
		formatString: #,0
		lineageTag: 92d92b9c-7326-4aa1-9a0a-c3703557087f

	measure 'Agences pour 10 000 hab' = DIVIDE ( [Agences], [Population] ) * 10000
		formatString: 0.00
		lineageTag: 3478c738-b590-457d-95e5-cf3eea3c556d

	measure 'DAB (OSM)' = SUM ( communes[dab_osm] )
		formatString: #,0
		lineageTag: 321f76c7-e728-466d-8468-d04f137a2db6

	measure 'Communes sans agence' = CALCULATE ( [Communes], communes[agences_bancaires_2025] = 0 )
		formatString: #,0
		lineageTag: 04bdfd22-66e7-4596-9f99-223abaa975f5

	measure 'Part communes sans agence' = DIVIDE ( [Communes sans agence], [Communes] )
		formatString: 0.0 %
		lineageTag: 98fb81cd-07b9-4a57-8f87-f731910fed68

	measure 'Population en désert bancaire' =
			VAR seuil = [Seuil désert (km) Valeur]
			RETURN
			    CALCULATE ( [Population], communes[distance_agence_km] >= seuil )
		formatString: #,0
		lineageTag: edab5b1c-00d8-4c5a-bd27-c50c68f9e47d

	measure 'Communes en désert bancaire' =
			VAR seuil = [Seuil désert (km) Valeur]
			RETURN
			    CALCULATE ( [Communes], communes[distance_agence_km] >= seuil )
		formatString: #,0
		lineageTag: ca4d18d3-6e18-4d9b-bc24-4fea46886093

	measure 'Part population en désert' = DIVIDE ( [Population en désert bancaire], [Population] )
		formatString: 0.0 %
		lineageTag: dd613e6d-f2d1-4fbf-b555-72d12786b4c9

	measure 'Communes ayant perdu leur agence' = SUM ( communes[a_perdu_agence_2020_2025] )
		formatString: #,0
		lineageTag: 27de1175-dc5f-4aa7-a93e-ed1a5f732103

	measure 'Communes sans agence ni DAB' = SUM ( communes[sans_agence_ni_dab] )
		formatString: #,0
		lineageTag: 511145ea-403a-4728-8d74-065144e309d7

	measure 'Distance moyenne à une agence (km)' =
			DIVIDE (
			    SUMX ( communes, communes[distance_agence_km] * communes[population_2023] ),
			    [Population]
			)
		formatString: 0.0
		lineageTag: e1b25665-abde-4a4a-9fd2-8ef3eb5bd794

