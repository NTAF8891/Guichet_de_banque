	partition communes = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DossierDonnees & "communes.csv"), [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]),
				    Entetes = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    Types = Table.TransformColumnTypes(Entetes, {{"code_commune", type text}, {"nom_commune", type text}, {"code_departement", type text}, {"nom_departement", type text}, {"code_region", type text}, {"nom_region", type text}, {"population_2023", type number}, {"lat", type number}, {"lon", type number}, {"agences_bancaires_2025", Int64.Type}, {"agence_presente_2020", Int64.Type}, {"agence_presente_2025", Int64.Type}, {"a_perdu_agence_2020_2025", Int64.Type}, {"a_gagne_agence_2020_2025", Int64.Type}, {"bureaux_poste_2025", Int64.Type}, {"relais_poste_2025", Int64.Type}, {"agences_postales_2025", Int64.Type}, {"points_postaux_2025", Int64.Type}, {"dab_osm", Int64.Type}, {"distance_agence_km", type number}, {"distance_dab_km", type number}, {"acces_agence", type text}, {"desert_bancaire", Int64.Type}, {"sans_agence_ni_dab", Int64.Type}}, "en-US")
				in
				    Types

	annotation PBI_ResultType = Table
