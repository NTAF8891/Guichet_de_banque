model Model
	culture: fr-FR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: fr-FR
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["DossierDonnees", "communes", "departements", "dab_osm", "references_bdf"]

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

ref table communes
ref table departements
ref table dab_osm
ref table references_bdf
ref table 'Seuil désert (km)'

ref cultureInfo fr-FR
